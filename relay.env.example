# ---------------------------------------------------------------------------
# relay.env.example — copy to relay.env and fill in.
#
# install.sh does that copy for you and fills in the handful of answers it
# asks for. Everything else can stay as it is; every value below is a
# working default.
#
# Real environment variables always win over anything written here, so
# `systemctl set-environment` or an EnvironmentFile= directive still
# overrides a line in this file.
#
# relay.env holds credentials. install.sh chmods it 600. Do not commit it.
# ---------------------------------------------------------------------------

# ---- who and where (required for the APRS feed) ---------------------------
# Your callsign is used to log in to APRS-IS. The passcode is derived from it
# automatically; the relay logs in receive-only and never transmits.
# Leave CALLSIGN blank if you do not want the APRS feed at all — see
# APRS_ENABLED at the bottom of this file.
CALLSIGN=
# Maidenhead grid square, e.g. EM73. Sets the centre of the APRS-IS filter
# and the default centre for repeater lookups. CENTER_LAT/CENTER_LON
# override it if you would rather give coordinates.
GRID=
CENTER_LAT=
CENTER_LON=
RADIUS_KM=100

APRS_HOST=rotate.aprs2.net
APRS_PORT=14580
APRS_RECONNECT_SECONDS=30

# ---- where the relay listens ----------------------------------------------
# 127.0.0.1 on purpose: nginx terminates TLS in front of it. Do not expose
# this port directly unless you know you want to.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8090
# The browser origin allowed to read these feeds. "*" works and is the
# simplest thing; narrowing it to the page that serves your dashboard is
# better if you know that origin.
ALLOWED_ORIGIN=*

# ---- NetLogger -------------------------------------------------------------
# NetLogger publishes a one-call-per-minute limit. 60 is a floor in code
# regardless of what you put here — this relay is what stands between
# however many browser tabs you open and NetLogger seeing one request a
# minute. Please do not try to defeat it.
NETLOGGER_POLL_SECONDS=60

# ---- live re-centring ------------------------------------------------------
# A dashboard can move the APRS-IS filter by passing ?grid= to /aprs.json.
# These guard against thrashing it.
RECENTER_MIN_DELTA_KM=2
RECENTER_COOLDOWN_SECONDS=20
STATION_MAX_AGE_SECONDS=3600

# ---- repeater sweep --------------------------------------------------------
# Feedline Labs answers "what is near this point" only, so the relay samples
# a grid of points across the continental US once a day and filters that
# union per request. It paces itself hard (serial, 12s between calls) because
# Feedline does rate-limit and this is somebody else's free service.
REPEATER_DEFAULT_RADIUS_KM=160
REPEATER_SWEEP_INTERVAL_HOURS=24

# ---- Grid Watch feeds ------------------------------------------------------
# KEV, DOE 202(c), NERC. Set false if you only want the ham feeds; the
# pollers then never start.
GRIDWATCH_ENABLED=true
KEV_POLL_HOURS=1
DOE_POLL_HOURS=6
NERC_POLL_HOURS=6

# ---- ISO/RTO operational alerts -------------------------------------------
# Working with no credentials: CAISO (OASIS operator system messages), ERCOT
# (grid-conditions endpoint), NYISO (dispatcher notice board).
ISOALERTS_ENABLED=true
ISOALERTS_POLL_MINUTES=10

# PJM has no keyless alert feed — Inside Lines serves a captcha to scripted
# clients and rss.pjm.com fails certificate verification. A free NON-MEMBER
# Data Miner 2 key is available:
#   1. register at
#      https://accountmanager.pjm.com/accountmanager/pages/public/new-user.jsf
#      and tick "Emergency Procedures Read Only" (and "PJM Public")
#   2. set the password from the emailed link within 4 hours
#   3. email accountmanager@pjm.com: "I confirm that the PJM Data will be
#      used for internal business purposes only." with your user ID
#   4. collect the key from https://apiportal.pjm.com/
#
# NOTE the restriction step 3 attaches to the account. PJM's own guide says
# non-member data is for internal business use, and that publishing or making
# derivatives of it requires membership. That is why this is a per-install
# key and not something shipped with the project: hold your own, and decide
# for yourself what you may do with what it returns.
PJM_API_KEY=
# Undocumented by PJM. This is the Azure API Management default and the
# likely one; if you get 401 with a key you know is good, try another.
PJM_API_KEY_HEADER=Ocp-Apim-Subscription-Key

# ISO-NE web services also need a free registered account.
ISONE_API_USER=
ISONE_API_PASSWORD=

# MISO, SPP and Southern have no public alert feed this relay can reach.
# They are reported as unavailable with the reason rather than shown as
# normal — an ISO nobody can read is not an ISO operating calmly.

# ---- briefing digests ------------------------------------------------------
# A daily grid brief's structured output, kept so the dashboard can diff each
# run against the last. Reads are open; writes need this token. install.sh
# generates one. Rotate by editing this line and restarting.
DIGEST_TOKEN=
DIGEST_MAX=400

# ---- reading the brief out of a mailbox ------------------------------------
# Optional. If whatever writes your daily brief can only send email, the
# relay can read it from a mailbox instead of you POSTing it.
BRIEFMAIL_ENABLED=false

# Two ways in. If both are set the IMAP host wins and the maildir is ignored,
# with a warning at startup — a stale local path should never quietly shadow
# a mailbox you actually named.
BRIEFMAIL_MAILDIR=
BRIEFMAIL_IMAP_HOST=
BRIEFMAIL_IMAP_PORT=993
BRIEFMAIL_IMAP_SSL=true
BRIEFMAIL_IMAP_USER=
BRIEFMAIL_IMAP_PASSWORD=
BRIEFMAIL_IMAP_FOLDER=INBOX
# Where a message goes once read. Blank: only marked \Seen.
BRIEFMAIL_ARCHIVE_FOLDER=
BRIEFMAIL_POLL_MINUTES=10

# Only messages whose Subject contains this are considered.
BRIEFMAIL_SUBJECT_MATCH=Grid Watch Digest

# Optional comma-separated sender allowlist. Convenience only: From is
# trivially forged, so this narrows accidents, not attacks.
BRIEFMAIL_FROM_ALLOW=

# The actual trust control. The brief's structured block must carry this as
# its "token" field or the relay refuses it. install.sh generates one.
BRIEFMAIL_SECRET=

# When nothing is unread, re-examine this many recent messages anyway.
# Reading the brief in a webmail client clears its unread flag, and an
# UNSEEN-only reader would then never see it again. Re-reading is harmless:
# a message already stored is recognised by Message-ID and skipped.
BRIEFMAIL_BACKFILL=20

BRIEFMAIL_KEEP_TEXT=true

LOG_LEVEL=INFO
